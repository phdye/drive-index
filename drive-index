#!/usr/bin/env python3
"""Drive-scoped wrappers around GNU locate and updatedb.

One program serves every <label>-<action> symlink. The name it was invoked
under carries both the label and the verb, so c-locate and 4tb-updatedb are
the same executable reached by two different paths.

This wraps the system updatedb rather than reimplementing it: builds go to a
temporary output path and are renamed into place only once they look sane, so
a failed or truncated run cannot destroy an index that took an hour to make.
That matters more here than usual, because most of these indexes describe
disks that are not attached -- the index is often the only copy of what is on
them.

Written to the Python 3.6 line, since this has to run on RHEL 8.10 as well as
on Cygwin.
"""

import argparse
import configparser
import filecmp
import glob
import json
import os
import platform
import shutil
import socket
import subprocess
import sys
import time

